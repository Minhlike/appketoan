# Node / Web dependencies & build artifacts
node_modules/
dist/
dist-ssr/
coverage/
*.local

# Tauri / Rust build artifacts
src-tauri/target/
crates/*/target/
target/
Cargo.lock

# Windows & IDE artifacts
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp

# Logs, scratch & audit runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
scratch/
temp/
audit/
audit-runtime/
.audit-runtime/
fixtures/artifacts/
**/fixtures/artifacts/
crates/reconciliation-core/fixtures/

# Releases and installers
releases/*.exe
releases/*.msi
releases/*.zip
!releases/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# STRICT SECURITY: Accounting / Business files protection
# Prevent accidental committing of real company financial data
*.xlsx
*.xls
*.xlsm
*.xlsb
*.csv
*.tsv
*.pdf
*.xml
*.jsonl

# EXCEPTIONS: Synthetic fixtures & test data
!fixtures/synthetic/**
!fixtures/expected/**
!fixtures/**/.gitkeep
!tests/**/.gitkeep
!docs/**
!.agent/**
